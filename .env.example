# Neon connection string (Vercel → Storage → Neon adds it automatically).
# Leave empty locally to use the built-in PGlite database in .data/pglite.
DATABASE_URL=

# Random secret for signing the admin session cookie (required in production).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Showcase deployment only: locks password change / pausing orders, hides from search
# engines and enables the nightly reset (needs CRON_SECRET too).
NEXT_PUBLIC_DEMO_MODE=
CRON_SECRET=
